# Copy this file to `.env` and fill in values as needed.
# Only AI_PROVIDER matters for a default (mock) run - everything else
# has a safe default.

# --- AI provider selection ------------------------------------------------
# "mock"   -> deterministic, offline, no API key required (default)
# "claude" -> live calls to the Anthropic API (requires CLAUDE_API_KEY)
AI_PROVIDER=mock

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=1024

# --- Site / SEO --------------------------------------------------------
BASE_URL=https://example.com
SITE_NAME=Event Platform
TWITTER_HANDLE=@events

# --- Image sourcing --------------------------------------------------------
# "redgiant" -> ImageAgent scrapes live candidate hero images from
#               REDGIANT_SITE_URL (default - this is the pilot mode).
# "null"     -> no network calls; every page gets a placeholder image.
IMAGE_SOURCE=redgiant
REDGIANT_SITE_URL=https://redgiant.co.ke

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
# Set to true to emit structured JSON log lines instead of plain text
LOG_JSON=false
